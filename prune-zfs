#!/bin/bash

if [ "$(id -u)" -ne 0 ]; then
    echo "This script requires root privileges. Attempting to escalate..."
    sudo "$0" "$@"
    exit 0
fi

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
source "$SCRIPT_DIR/.config"

# Check hdd
echo "Checking local /storage mount..."
if ! mountpoint -q -- /storage; then
    echo "ERROR: /storage is not a valid mount point"
    exit 1
fi

echo "Pruning old snapshots"
prune_zfs_snapshots() {
    local target_pool_or_ds="$1"
    local keep="${2:-10}"

    # Get all datasets under the target (including the root dataset itself)
    mapfile -t datasets < <(zfs list -H -o name -r "$target_pool_or_ds")

    for ds in "${datasets[@]}"; do
        # Fetch snapshots for this specific dataset only (-depth 1 avoids child mixing)
        local snapshots
        snapshots=$(zfs list -t snapshot -d 1 -H -p -o name,creation "$ds" 2>/dev/null | sort -k2 -rn | awk '{print $1}')

        if [ -z "$snapshots" ]; then
            continue
        fi

        local count
        count=$(wc -l <<< "$snapshots")

        if (( count <= keep )); then
            echo "  $ds: nothing to prune ($count snapshots, keeping $keep)"
            continue
        fi

        echo "$snapshots" | tail -n "+$((keep + 1))" | while read -r name; do
            echo "  PRUNE  $name"
            zfs destroy "$name"
        done

        echo "  $ds: pruned $((count - keep)) snapshot(s), kept $keep"
    done
}

prune_zfs_snapshots zroot 10
prune_zfs_snapshots datapool 10
echo "ZFS pruned"
